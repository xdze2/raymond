.venv/
__pycache__/
*.pyc

# secrets — keep .env.example tracked
.env

# generated per-wiki index, rebuilt by build_index.py / dev_server.py
wikis/*/index.jsonl

# CLI run logs, written by tools/atlas.py
wikis/*/logs/

# generated standalone bundles
dist/

# frontend test deps
node_modules/

# --- wiki data (generated / curated content; kept locally, not versioned) ---
# Wiki *definitions* stay tracked: wiki.json, axis.json, prompts/, scripts.
wikis/*/catalogue/
wikis/*/enrichments/
wikis/*/media/
wikis/*/pages/
archive/*/catalogue/
archive/*/enrichments/
archive/*/media/
archive/*/pages/

.pytest_cache/
